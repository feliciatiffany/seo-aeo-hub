# Copy to .env (never commit .env)
AHREFS_API_KEY=
# Your domain, used only with --live (consumes API units)
AHREFS_TARGET=example.com
# Spending guards (API units). A live run costs ~700 units.
AHREFS_MONTHLY_BUDGET=20000
AHREFS_RUN_BUDGET=1500
# Skip a live Ahrefs run if the last one was fewer than this many days ago (saves units).
AHREFS_MIN_DAYS_BETWEEN=6
# Re-pull the costly referring-domains list only this often; the dashboard reuses the last pull in between.
AHREFS_SLOW_EVERY_DAYS=14

# --- Google (GA4 + Search Console) ---
# Robot (service account) email. The hub borrows its read-only identity through
# your gcloud sign-in, so no key file is needed (useful if your organisation blocks key files).
GOOGLE_IMPERSONATE=
# GA4 → Admin → Property details → Property ID (numbers only)
GA4_PROPERTY_ID=
# Search Console property, exactly as shown in Search Console:
#   Domain property: sc-domain:example.com    URL-prefix: https://www.example.com/
GSC_SITE_URL=sc-domain:example.com
# Usage guards (both APIs are free; these stop the hub before it uses too much)
# Before a run: max runs per source per day (checks included), and monthly caps
GOOGLE_MAX_RUNS_PER_DAY=5
GA4_MONTHLY_TOKEN_BUDGET=2000
GSC_MONTHLY_REQUEST_BUDGET=100
# During a GA4 run: stop past this many tokens, or if the property is running low
GA4_RUN_TOKEN_BUDGET=100
GA4_MIN_DAILY_TOKENS_LEFT=100000
GA4_MIN_HOURLY_TOKENS_LEFT=20000
# Search Console: max rows per request
GSC_MAX_ROWS=1000

# Which link clicks count as Book demo / Sign up / Log in (regular expressions,
# matched against the clicked link; checked in this order)
HUB_DEMO_LINKS=calendly\.com|cal\.com|meetings\.hubspot\.com|/demo
HUB_SIGNUP_LINKS=app\.example\.com/sign-?up
HUB_LOGIN_LINKS=app\.example\.com

# Your brand and site (shown on the page and used in brand-search advice)
HUB_BRAND=Your brand
HUB_BRAND_TERMS=your brand,yourbrand
HUB_SITE_URL=https://example.com
# Your website's source repo (Markdown posts in src/content/{blog,releases}, git history for the change markers)
HUB_CONTENT_DIR=../website/src/content
HUB_SITE_REPO=../website
